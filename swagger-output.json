{
  "swagger": "2.0",
  "info": {
    "title": "Equipment Tracker API",
    "description": "API for managing inventory and customer write operations.",
    "version": "1.0.0"
  },
  "basePath": "/",
  "paths": {
    "/inventory": {
      "get": {
        "summary": "List all inventory items",
        "description": "Returns every inventory item in the collection.",
        "responses": {
          "200": {
            "description": "Inventory items returned"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/Inventory"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Inventory item created"
          },
          "400": {
            "description": "Invalid inventory data"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/inventory/{id}": {
      "get": {
        "summary": "Get an inventory item by ID",
        "description": "Returns the inventory item matching the supplied MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Inventory item returned"
          },
          "400": {
            "description": "Invalid document ID"
          },
          "404": {
            "description": "Inventory item not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/Inventory"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Inventory item updated"
          },
          "400": {
            "description": "Invalid ID or inventory data"
          },
          "404": {
            "description": "Inventory item not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "204": {
            "description": "Inventory item deleted"
          },
          "400": {
            "description": "Invalid document ID"
          },
          "404": {
            "description": "Inventory item not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/customers": {
      "get": {
        "summary": "List all customers",
        "description": "Returns every customer in the collection.",
        "responses": {
          "200": {
            "description": "Customers returned"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "post": {
        "description": "",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/Customer"
            }
          }
        ],
        "responses": {
          "201": {
            "description": "Customer created"
          },
          "400": {
            "description": "Invalid customer data"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    },
    "/customers/{id}": {
      "get": {
        "summary": "Get a customer by ID",
        "description": "Returns the customer matching the supplied MongoDB ObjectId.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "200": {
            "description": "Customer returned"
          },
          "400": {
            "description": "Invalid document ID"
          },
          "404": {
            "description": "Customer not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "put": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          },
          {
            "name": "body",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/Customer"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Customer updated"
          },
          "400": {
            "description": "Invalid ID or customer data"
          },
          "404": {
            "description": "Customer not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      },
      "delete": {
        "description": "",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "type": "string"
          }
        ],
        "responses": {
          "204": {
            "description": "Customer deleted"
          },
          "400": {
            "description": "Invalid document ID"
          },
          "404": {
            "description": "Customer not found"
          },
          "500": {
            "description": "Internal server error"
          }
        }
      }
    }
  },
  "definitions": {
    "Inventory": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Excavator"
        },
        "description": {
          "type": "string",
          "example": "Tracked excavator for construction work."
        },
        "category": {
          "type": "string",
          "example": "Heavy Machinery"
        },
        "serialNumber": {
          "type": "string",
          "example": "EXC-001"
        },
        "dailyRate": {
          "type": "number",
          "example": 1500
        },
        "status": {
          "type": "string",
          "example": "available"
        },
        "condition": {
          "type": "string",
          "example": "Good"
        }
      }
    },
    "Customer": {
      "type": "object",
      "properties": {
        "firstName": {
          "type": "string",
          "example": "John"
        },
        "lastName": {
          "type": "string",
          "example": "Doe"
        },
        "email": {
          "type": "string",
          "example": "john@example.com"
        },
        "phone": {
          "type": "string",
          "example": "555-123-4567"
        }
      }
    }
  }
}